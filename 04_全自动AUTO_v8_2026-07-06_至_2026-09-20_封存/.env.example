# ===== Polymarket AUTO 全自动账户 — 环境变量模板 =====
# 复制成 .env 后填真值。.env 永不进 git。

# --- Polymarket 新账户 (用户提供; 缺省时程序照常启动但只读、不能交易) ---
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=3
# POLY_FUNDER = polymarket.com 点头像→Profile 页 URL 里那串 0x 地址 (= 充值地址),
#               不是钱包 EOA 地址! 填错 = 余额永远读 0。
# POLY_PRIVATE_KEY = 同一个账户的私钥 (邮箱注册→Settings 里导出; 钱包注册→那个钱包的 key)
# POLY_SIGNATURE_TYPE: 2026 新注册账户(存款钱包)=3; 老式 Magic/钱包账户才是 1/2
# POLY_API_KEY / POLY_API_SECRET / POLY_API_PASSPHRASE 不用填 —— 每次启动用私钥自动派生 (内存), 留空即可

# --- LLM: 智谱两把 key 分工, 绝不混用 (用户 2026-07-08 定, 智谱后台各自记账) ---
# 选品搜索专用 (auto_discovery 自动选品读这把)
ZHIPUAI_API_KEY_DISCOVERY=
# 重评专用 (autobot 启动时映射给 auto_reeval)
ZHIPUAI_API_KEY_REEVAL=
# 可选: Claude 兜底 (是否保留等商讨后定; 不填 = 纯智谱)
# ANTHROPIC_API_KEY=

# --- Dashboard ---
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=

# --- 可选调参 (有默认值, 一般不用动) ---
# AUTO_DAILY_REEVAL_HOUR=10        (24h 全仓巡检重评每天几点跑, 本机时间)
# AUTO_DISCOVERY_MIN_CANDIDATES=5  (单 tag 候选少于这个数就不送 GLM, 用户规则)
# AUTO_REEVAL_PRIMARY=glm
# AUTO_REEVAL_GLM_MODEL=glm-5.2
# AUTO_REEVAL_COOLDOWN_H=6
# SIZING_KELLY_FRACTION=0.20

# ===== Bench 第二账户基准策略 (可选; 纯测 AI 准确率) =====
BENCH_DRY_RUN=0
BENCH_POLY_PRIVATE_KEY=
BENCH_POLY_FUNDER=
BENCH_POLY_SIGNATURE_TYPE=3
BENCH_USD_PER_POS=2
BENCH_STOP_LOSS_PCT=0.30
