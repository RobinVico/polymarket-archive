# 出入金跳变识别阈值 (2026-07-16 用户: 入金把曲线搞断): 相邻快照 |Δcash| ≥ 这个数才算出入金候选
DEPOSIT_JUMP_MIN = float(os.environ.get("AUTO_DEPOSIT_JUMP_MIN", "5"))


def _adjusted_portfolio_history(rng):
    """出入金校正后的资产曲线 (2026-07-16 用户拍板: 入金 $50 把总值曲线搞断 → 要曲线保持正常)。
    识别: 相邻快照 |Δcash| ≥ DEPOSIT_JUMP_MIN 且 Δassets ≈ Δcash (容差 max($2, 10%)) = 出/入金
          —— 买卖/结算兑付都是 现金↔持仓 对倒, Δassets≈0, 不会误判 (实测 422 快照只命中两次真实入金)。
    校正: 每个点加上"该点之后发生的出入金净额" → 入金前的历史整体抬到当前本金口径:
          曲线连续、终点=真实总资产、任意区间涨跌=纯交易盈亏。老接口 /api/portfolio_history 不动。
    附带把"入金前预热点"裁剪从前端挪到这里 (对原始值判断更准)。"""
    from modules.db import get_portfolio_history
    import time as _t
    now = int(_t.time())
    since = {"1d": now - 86400, "1w": now - 7 * 86400, "1m": now - 30 * 86400,
             "1y": now - 365 * 86400}.get(rng, 0)
    rows = get_portfolio_history(0, max_points=100000)   # 全量拉 (识别必须看完整相邻序列)
    if not rows:
        return {"ok": True, "range": rng, "points": [], "deposits": [], "note": ""}
    # 前缀预热点裁剪 (原前端逻辑): 还没入金那会儿的零星小点, 会把 y 轴拉出大跨度
    mx = max((r.get("assets_total") or 0) for r in rows)
    i0 = 0
    while i0 < len(rows) and (rows[i0].get("cash") or 0) <= 0.005 and (rows[i0].get("assets_total") or 0) < mx * 0.2:
        i0 += 1
    if 0 < i0 < len(rows):
        rows = rows[i0:]
    # 识别出入金 (金额取 Δcash; 同一间隔里顺带的小幅行情波动保留在曲线里)
    deposits = []
    for a, b in zip(rows, rows[1:]):
        dc = (b.get("cash") or 0) - (a.get("cash") or 0)
        da = (b.get("assets_total") or 0) - (a.get("assets_total") or 0)
        if abs(dc) >= DEPOSIT_JUMP_MIN and abs(da - dc) <= max(2.0, abs(dc) * 0.1):
            deposits.append({"ts": b["ts"], "amount": round(dc, 2)})
    total = sum(d["amount"] for d in deposits)
    out = []
    cum = 0.0
    di = 0
    for r in rows:
        while di < len(deposits) and deposits[di]["ts"] <= r["ts"]:
            cum += deposits[di]["amount"]
            di += 1
        adj = total - cum   # 该点之后还会发生的出入金 → 抬平历史
        at = (r.get("assets_total") or 0) + adj
        tc, ch = r.get("total_cost"), r.get("cash")
        cost_line = (tc + ch + adj) if (tc is not None and ch is not None) else None
        out.append({"ts": r["ts"], "assets_total": round(at, 4), "cost_line": cost_line,
                    "cash": ch, "total_value": r.get("total_value"), "adj": round(adj, 2)})
    if since:
        out = [p for p in out if p["ts"] >= since]
    note = ""
    if deposits:
        note = "已校正出入金: " + ", ".join(
            ("%s$%.2f" % ("+" if d["amount"] >= 0 else "-", abs(d["amount"]))) for d in deposits)
    return {"ok": True, "range": rng, "points": out, "deposits": deposits, "note": note}


def _build_monitor_payload():
    """只读聚合: 把 events / auto_trades / auto_discovery_runs / auto_candidates /
    auto_reeval_suggestions / app_state 揉成监控页要的结构。每段各自 try, 一张表坏不拖垮整页。"""
    from modules.db import get_conn, get_recent_events, get_app_state, _parse_iso_to_aware

    payload = {"ok": True, "days": [], "alerts": [], "discovery_runs": [],
               "candidates_pending": [], "reeval": {"last_slot": None, "recent": []},
               "events": [], "version": ""}
    try:
        from modules.version import VERSION
        payload["version"] = VERSION
    except Exception:
        pass

    def local_date(iso):
        dt = _parse_iso_to_aware(iso)
        return dt.astimezone().strftime("%Y-%m-%d") if dt else ""

    def local_hm(iso):
        dt = _parse_iso_to_aware(iso)
        return dt.astimezone().strftime("%H:%M") if dt else ""

    days = {}

    def day(d):
        if not d:
            d = "?"
        if d not in days:
            days[d] = {"date": d, "buys": [], "sells": [], "alerts": [], "paper": 0, "usd_buy": 0.0}
        return days[d]

    # slug → 好看标题 (auto_trades 只存 slug, 事件卖出存的是标题)
    title_by_slug = {}
    try:
        conn = get_conn()
        for r in conn.execute("SELECT slug, title FROM auto_candidates WHERE title IS NOT NULL AND title != ''"):
            if r["slug"] and r["slug"] not in title_by_slug:
                title_by_slug[r["slug"]] = r["title"]
        conn.close()
    except Exception as e:
        log.warning(f"title map failed: {e}")

    # ---- 买入: auto_trades (成交台账, usd 精确) ----
    try:
        conn = get_conn()
        for r in conn.execute("SELECT ts, day, slug, side, usd, note FROM auto_trades WHERE ok=1 ORDER BY id DESC LIMIT 300"):
            d = r["day"] or local_date(r["ts"])
            e = day(d)
            usd = float(r["usd"] or 0)
            e["buys"].append({"time": local_hm(r["ts"]), "title": title_by_slug.get(r["slug"], r["slug"]),
                              "slug": r["slug"], "side": (r["side"] or "").upper(), "usd": round(usd, 2),
                              "note": r["note"] or ""})
            e["usd_buy"] += usd
        conn.close()
    except Exception as e:
        log.warning(f"buys agg failed: {e}")

    # ---- 卖出 / 无档案红警 / 测试仓计数: events ----
    try:
        for ev in get_recent_events(500):
            et = ev.get("event_type")
            ts = ev.get("timestamp")
            d = local_date(ts)
            if et in ("auto_sell", "user_sell"):
                day(d)["sells"].append({"time": local_hm(ts),
                                        "label": "自动卖出" if et == "auto_sell" else "手动/清仓",
                                        "title": (ev.get("market_slug") or "").strip(),
                                        "detail": (ev.get("detail") or "").strip()})
            elif et == "no_meta_alert":
                a = {"level": "red", "time": local_hm(ts), "date": d, "kind": "无档案仓",
                     "title": (ev.get("market_slug") or "").strip(), "detail": (ev.get("detail") or "").strip()}
                day(d)["alerts"].append(a)
                payload["alerts"].append(a)
            elif et == "paper_add":
                day(d)["paper"] += 1
    except Exception as e:
        log.warning(f"events agg failed: {e}")

    # ---- GLM 选品运行状况 + 报错/超时黄警 ----
    try:
        conn = get_conn()
        for r in conn.execute("SELECT scan_slot, tag, ok, n_recs, n_invalid, tokens_prompt, tokens_completion, error, started_at "
                              "FROM auto_discovery_runs ORDER BY id DESC LIMIT 60"):
            err = (r["error"] or "").strip()
            payload["discovery_runs"].append({
                "slot": r["scan_slot"], "tag": r["tag"], "ok": r["ok"], "n_recs": r["n_recs"],
                "n_invalid": r["n_invalid"],
                "tokens": "%d+%d" % (r["tokens_prompt"] or 0, r["tokens_completion"] or 0),
                "error": err})
            if err:
                d = local_date(r["started_at"])
                a = {"level": "yellow", "time": local_hm(r["started_at"]), "date": d, "kind": "GLM选品报错",
                     "title": "标签 " + (r["tag"] or "?"), "detail": err}
                payload["alerts"].append(a)
                day(d)["alerts"].append(a)
        conn.close()
    except Exception as e:
        log.warning(f"discovery agg failed: {e}")

    # ---- 未成交候选 (GLM 选了但没成真仓) + 宇宙外/防对锁 黄/灰警 ----
    try:
        conn = get_conn()
        for r in conn.execute("SELECT created_at, tag, title, slug, side, cur_price, q, route, status "
                              "FROM auto_candidates ORDER BY id DESC LIMIT 120"):
            status = (r["status"] or "").strip()
            # 真的成了活着的真仓 → 不算"未成交"
            if status.startswith("bought") and "已清仓" not in status:
                continue
            cand = {"time": local_hm(r["created_at"]), "date": local_date(r["created_at"]),
                    "tag": r["tag"], "title": r["title"] or r["slug"], "slug": r["slug"],
                    "side": (r["side"] or "").upper(),
                    "cur_price": r["cur_price"], "q": r["q"], "route": r["route"], "status": status}
            payload["candidates_pending"].append(cand)
            if any(k in status for k in ("宇宙", "非白名单", "防对锁")):
                lvl = "gray" if "已持有" in status else "yellow"
                a = {"level": lvl, "time": cand["time"], "date": cand["date"], "kind": "候选被拒",
                     "title": cand["title"], "detail": status}
                payload["alerts"].append(a)
        conn.close()
    except Exception as e:
        log.warning(f"candidates agg failed: {e}")

    # ---- 自动重评建议 (2026-07-12 用户: 老页整块搬来, 只读展示 — 全自动执行, 无需任何操作) ----
    try:
        payload["reeval"]["last_slot"] = get_app_state("auto_daily_reeval_last_slot")
        import json as _json
        conn = get_conn()
        for r in conn.execute("SELECT id, title, slug, side, action, reason, status, created_at, "
                              "orig_q, new_q, trigger_reason, headline_event, provider, "
                              "loss_pct, confidence, thesis_broken, error, sources "
                              "FROM auto_reeval_suggestions ORDER BY id DESC LIMIT 30"):
            try:
                srcs = _json.loads(r["sources"] or "[]")
                srcs = [str(u) for u in srcs][:5] if isinstance(srcs, list) else []
            except Exception:
                srcs = []
            payload["reeval"]["recent"].append({
                "id": r["id"],
                "date": local_date(r["created_at"]), "time": local_hm(r["created_at"]),
                "title": r["title"] or r["slug"] or "", "side": (r["side"] or "").upper(),
                "action": (r["action"] or "").strip(), "status": (r["status"] or "").strip(),
                "orig_q": r["orig_q"], "new_q": r["new_q"], "loss_pct": r["loss_pct"],
                "confidence": (r["confidence"] or "").strip(),
                "thesis_broken": bool(r["thesis_broken"]),
                "trigger": (r["trigger_reason"] or "").strip(),
                "headline": (r["headline_event"] or "").strip()[:160],
                "provider": (r["provider"] or "").strip(),
                "error": (r["error"] or "").strip()[:200],
                "sources": srcs,
                "reason": (r["reason"] or "").strip()[:300]})
        conn.close()
    except Exception as e:
        log.warning(f"reeval agg failed: {e}")

    # ---- 操作记录 (老页 📝 整块搬来, 只读): 全部事件流 ----
    try:
        for ev in get_recent_events(150):
            payload["events"].append({
                "date": local_date(ev.get("timestamp")), "time": local_hm(ev.get("timestamp")),
                "type": ev.get("event_type") or "", "title": (ev.get("market_slug") or "").strip(),
                "detail": (ev.get("detail") or "").strip()})
    except Exception as e:
        log.warning(f"events feed failed: {e}")

    # ---- 组装按天战报 (新→旧) ----
    for d in sorted(days.keys(), reverse=True):
        e = days[d]
        try:
            wd = _WD[datetime.strptime(d, "%Y-%m-%d").weekday()]
        except Exception:
            wd = ""
        payload["days"].append({**e, "weekday": wd, "usd_buy": round(e["usd_buy"], 2),
                                "n_buy": len(e["buys"]), "n_sell": len(e["sells"]),
                                "n_alert": len(e["alerts"])})

    payload["alerts"].sort(key=lambda a: (a.get("date", ""), a.get("time", "")), reverse=True)
    payload["alerts"] = payload["alerts"][:40]
    return payload


def _build_holdings():
    """当前持仓 (rich, 跟老主页「当前持仓(只看)」面板同字段): 入场价/当前价/份数/价值/盈亏/
    q·信心·止损档/决策状态。数据 = Executor 实时缓存 + position_meta。顺带算顶部四个指标。
    (老 /api/snapshot 不吐 confidence/stop_loss_tier, 故本模块自己读 meta 补全, 显示不缩水。)"""
    from modules.executor import Executor
    from modules.db import get_position_meta
    from datetime import datetime, timezone
    exe = Executor.get()
    positions = exe.get_positions_cached()
    cash_raw = exe.get_cash_cached()
    cash = cash_raw if cash_raw is not None else 0
    rows = []
    total_pnl = total_cost = total_value = 0.0
    for p in positions:
        cp = p.get("cur_price") or 0
        ap = p.get("avg_price") or 0
        sz = p.get("size") or 0
        asset = p.get("asset", "")
        meta = get_position_meta(asset) or {}
        pnl_pct = ((cp - ap) / ap * 100) if ap > 0 else 0
        pd = (cp - ap) * sz
        days_left = None
        ed = meta.get("end_date") or ""
        if ed:
            try:
                edt = datetime.fromisoformat(str(ed).replace("Z", "+00:00"))
                if edt.tzinfo is None:
                    edt = edt.replace(tzinfo=timezone.utc)
                days_left = (edt - datetime.now(timezone.utc)).days
            except Exception:
                pass
        rows.append({
            "asset": asset, "title": p.get("title", "") or "", "side": (p.get("side") or "").upper(),
            "avg_price": ap, "cur_price": cp, "size": sz, "value": cp * sz,
            "pnl_pct": pnl_pct, "pnl_dollar": pd, "days_left": days_left,
            "q": meta.get("new_tp") or meta.get("tp"),
            "confidence": meta.get("original_confidence"),
            "stop_loss_tier": meta.get("stop_loss_tier"),
            "monitor_state": meta.get("monitor_state"),
            "autostop_disabled": bool(meta.get("autostop_disabled")),
        })
        total_pnl += pd
        total_cost += ap * sz
        total_value += cp * sz
    return {"ok": True, "positions": rows, "total_pnl": total_pnl, "total_cost": total_cost,
            "total_value": total_value, "cash": cash, "assets_total": total_value + cash,
            "position_count": len(rows)}


def register_routes(app):
    from flask import jsonify

    @app.route("/monitor")
    def auto_monitor_page():
        return MONITOR_HTML

    @app.route("/api/auto/monitor")
    def auto_monitor_api():
        try:
            return jsonify(_build_monitor_payload())
        except Exception as e:
            log.exception(f"/api/auto/monitor failed: {e}")
            return jsonify({"ok": False, "message": str(e), "days": [], "alerts": [],
                            "discovery_runs": [], "candidates_pending": [],
                            "reeval": {"last_slot": None, "recent": []}})

    @app.route("/api/auto/portfolio_history")
    def auto_portfolio_history_api():
        from flask import request as _rq
        rng = (_rq.args.get("range") or "1w").lower()
        try:
            return jsonify(_adjusted_portfolio_history(rng))
        except Exception as e:
            log.exception(f"/api/auto/portfolio_history failed: {e}")
            return jsonify({"ok": False, "message": str(e), "points": [], "deposits": [], "note": ""})

    @app.route("/api/auto/holdings")
    def auto_holdings_api():
        try:
            return jsonify(_build_holdings())
        except Exception as e:
            log.exception(f"/api/auto/holdings failed: {e}")
            return jsonify({"ok": False, "message": str(e), "positions": [], "total_pnl": 0,
                            "total_cost": 0, "total_value": 0, "cash": 0, "assets_total": 0,
                            "position_count": 0})

    # autobot 会用它覆盖 app.view_functions['index'] → `/` 直接出监控页
    return auto_monitor_page


